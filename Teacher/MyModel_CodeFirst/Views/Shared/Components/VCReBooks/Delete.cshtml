@model IEnumerable<MyModel_CodeFirst.Models.ReBook>
@{
	Layout = null;
}
@* //4.3.3 將Delete View重新排版並加入刪除回覆留言的按鈕 *@
@if (Model.Count() != 0)
{
	@foreach (var item in Model)
	{
		<p class="text-truncate">@Html.DisplayFor(modelItem => item.Description)</p>
		<p class="text-end">@Html.DisplayFor(modelItem => item.Author) 於 @Html.DisplayFor(modelItem => item.CreatedDate) 回覆 <button class="btn btn-danger btn-sm">刪除</button></p>
		<hr />
	}

}

