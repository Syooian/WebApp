@model IEnumerable<Book>

@{
    Layout = null;
}

<div class="row">
    <h3>@Model.Count()</h3>

    @foreach (var item in Model)
    {
        <div class="card mb-4">
            @if (item.Photo != null)
            {


                <img src="~/BookPhotos/@item.Photo" class="card-img-top img-thumbnail" />
            }
            <div class="card-body">
                <h3>@Html.DisplayFor(modelItem => item.Title)</h3>

                <!--切斷過長文章效果-->
                <p class="text-truncate" style="width:100px">@Html.Raw(item.Description.Replace("\r\n", "<br>"))</p>
            </div>


        </div>
    }
</div>