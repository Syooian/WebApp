@using Homework1.Views.Shared
@model Homework1.Models.MainText

<div>
    <h4>@Html.DisplayFor(model => model.Title)</h4>
    <hr />
    <div class="row">
        <dl class="row col-6">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Content)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Content)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.CreatedDate)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.CreatedDate)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.UserName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.UserName)
            </dd>
        </dl>
        <div class="col-6">
            @if (Model.Photo != null)
            {
                <img src=@($"/{Shared.MainTextPhotosPath}/{Model.Photo}{Model.PhotoType}") width="500">
            }
        </div>
    </div>
</div>
<div>
    @*<a asp-action="Edit" asp-route-id="@Model?.MainTextID">Edit</a> |*@
    <a asp-action="Index" class="btn btn-primary">返回列表</a>
</div>
