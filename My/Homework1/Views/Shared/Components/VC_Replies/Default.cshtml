@model IEnumerable<Homework1.Models.Reply>
@{
    Layout = null;//不要使用任何共用Layout
}

@if (Model.Count() != 0)
{
    <h4 class="text-center">所有回覆</h4>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Content)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UserName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CreatedDate)
                </th>
                @*<th></th>*@
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Content)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.UserName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedDate)
                    </td>
                    @*<td>
                        <a asp-action="Edit" asp-route-id="@item.ReplyID">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.ReplyID">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.ReplyID">Delete</a>
                    </td>*@
                </tr>
            }
        </tbody>
    </table>
}
